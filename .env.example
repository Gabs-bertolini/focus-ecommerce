# Copy this file to .env and fill in real values.

# ---- Postgres ----
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce

# ---- API (JWT) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600

# ---- URLs ----
# Public frontend URL, used by the API's CORS config.
# E.g.: http://192.168.0.211:46464 (staging) or https://myshop.com (prod)
FRONTEND_URL=http://localhost:46464

# ---- Admin seed ----
# Used only on first startup to create the default admin user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me